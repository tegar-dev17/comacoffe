# Application
NODE_ENV=development
PORT=3001
API_BASE_URL=http://localhost:3001
DATABASE_URL=postgresql://comacoffe:comacoffe@localhost:5432/comacoffe
JWT_SECRET=change-me-in-production-min-32-chars-long

# Payment defaults (server-side only — never expose secrets to the browser)
PAYMENT_PROVIDER=midtrans
PAYMENT_ENV=sandbox

# Midtrans Core API (https://docs.midtrans.com/reference/qris)
# Sandbox keys start with SB-; production keys do not.
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_MERCHANT_ID=
# Prefer MIDTRANS_ENVIRONMENT for Midtrans API host selection (sandbox | production).
MIDTRANS_ENVIRONMENT=sandbox
# Optional override; default is derived from MIDTRANS_ENVIRONMENT:
#   sandbox  -> https://api.sandbox.midtrans.com
#   production -> https://api.midtrans.com
# MIDTRANS_API_BASE_URL=https://api.sandbox.midtrans.com
# Set in Midtrans Dashboard → Settings → Configuration → Notification URL:
# MIDTRANS_NOTIFICATION_URL=https://your-api-host/api/v1/webhooks/midtrans/notification
MIDTRANS_QRIS_ACQUIRER=gopay

# Xendit QR Codes API (https://developers.xendit.co)
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=
XENDIT_API_BASE_URL=https://api.xendit.co

# Operational
PAYMENT_REFRESH_RATE_LIMIT_PER_MINUTE=10
WEBHOOK_RATE_LIMIT_PER_MINUTE=120
RECONCILIATION_BATCH_SIZE=50
LOG_LEVEL=info
ENABLE_DEV_ROUTES=false
# When Midtrans returns "Payment channel is not activated", use staging QR + dev simulate (non-production NODE_ENV only).
ENABLE_QRIS_STAGING_FALLBACK=false
REFUND_APPROVAL_THRESHOLD_MINOR=500000
RECONCILIATION_INTERVAL_MS=60000
RECONCILIATION_STALE_MINUTES=15
OUTBOX_INTERVAL_MS=5000
OUTBOX_MAX_ATTEMPTS=8
ENABLE_RLS=false

# Optional sandbox E2E (never commit real keys)
# MIDTRANS_E2E=1

# Production QRIS checklist (API server only):
# NODE_ENV=production
# PAYMENT_ENV=production
# MIDTRANS_ENVIRONMENT=production
# MIDTRANS_SERVER_KEY=<production Server Key from Midtrans Dashboard>
# Notification URL in dashboard must match your public API webhook route.
