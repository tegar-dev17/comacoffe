# Application
NODE_ENV=development
PORT=3001
API_BASE_URL=http://localhost:3001
DATABASE_URL=postgresql://comacoffe:comacoffe@localhost:5432/comacoffe
JWT_SECRET=change-me-in-production-min-32-chars-long

# Payment defaults (server-side only — never expose secrets to the browser)
PAYMENT_PROVIDER=midtrans
PAYMENT_ENV=sandbox

# Midtrans Core API (https://docs.midtrans.com/reference/qris)
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_MERCHANT_ID=
MIDTRANS_API_BASE_URL=https://api.sandbox.midtrans.com

# Xendit QR Codes API (https://developers.xendit.co)
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=
XENDIT_API_BASE_URL=https://api.xendit.co

# Operational
PAYMENT_REFRESH_RATE_LIMIT_PER_MINUTE=10
RECONCILIATION_BATCH_SIZE=50
LOG_LEVEL=info
